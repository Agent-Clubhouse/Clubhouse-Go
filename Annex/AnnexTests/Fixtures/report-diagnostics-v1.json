{
 "contract": {
  "v": 1,
  "limits": {
   "totalBytes": 65536,
   "entries": 500,
   "stringBytes": 4096,
   "attrsPerEntry": 32
  },
  "tokenPattern": "^[A-Za-z0-9_.:+-]{1,64}$",
  "states": [
   "attached",
   "none",
   "left_out",
   "unavailable"
  ],
  "levels": [
   "debug",
   "info",
   "warn",
   "error"
  ],
  "deliveryResults": [
   "ok",
   "none",
   "timeout",
   "tls",
   "dns",
   "refused",
   "closed",
   "oversize",
   "overflow",
   "busy",
   "storage",
   "auth",
   "protocol",
   "cancelled",
   "server",
   "offline",
   "unknown"
  ],
  "reasons": {
   "none": [
    "empty",
    "no-provider"
   ],
   "unavailable": [
    "provider-failed",
    "invalid"
   ]
  },
  "serverReasons": {
   "unavailable": [
    "storage-failed"
   ]
  },
  "attrs": {
   "numbers": [
    "attempt",
    "backoffMs",
    "snapshotBytes",
    "webSocketMessageLimitBytes",
    "transportFrameLimitBytes",
    "durationMs",
    "count",
    "bytes",
    "responseBytes",
    "requestBytes",
    "connectMs",
    "tlsMs",
    "firstByteMs"
   ],
   "integerRanges": {
    "statusCode": [
     100,
     599
    ],
    "closeCode": [
     1000,
     4999
    ],
    "exitCode": [
     0,
     255
    ]
   },
   "enums": {
    "failure": [
     "timeout",
     "tls",
     "dns",
     "refused",
     "closed",
     "oversize",
     "overflow",
     "busy",
     "storage",
     "auth",
     "protocol",
     "cancelled",
     "server",
     "offline",
     "unknown"
    ],
    "link": [
     "mtls",
     "bearer",
     "unknown"
    ]
   },
   "tokens": [
    "operation"
   ],
   "shortTokens": [
    "fromState",
    "toState",
    "reason",
    "provider",
    "driver"
   ],
   "shortTokenPattern": "^[a-z0-9][a-z0-9_.-]{0,31}$",
   "ids": {
    "connectionId": "uuid",
    "attemptId": "uuid",
    "traceId": "trace",
    "spanId": "span"
   },
   "refs": [
    "peerRef",
    "agentRef"
   ],
   "refPattern": "^[0-9a-f]{16}$"
  }
 },
