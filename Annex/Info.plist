<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Clubhouse Go</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.Agent-Clubhouse.Go.pairing</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>clubhousego</string>
			</array>
		</dict>
	</array>
	<key>FramebriarGameID</key>
	<string>clubhouse-annex</string>
	<!-- The source commit, sent as Framebriar buildSha. scripts/testflight.sh sets it; empty elsewhere. -->
	<key>FramebriarBuildSHA</key>
	<string>$(FRAMEBRIAR_BUILD_SHA)</string>
	<!--
	The desktop uses a self-signed certificate, reached over home Wi-Fi or Tailscale
	(100.64.0.0/10), which ATS does not count as local. Every desktop connection pins
	the exact certificate from pairing and presents a client certificate, so ATS adds
	nothing there. The app's other connections (telemetry, feedback) accept only https
	URLs in code and refuse redirects. NSAllowsLocalNetworking must stay out: when it is
	present iOS ignores NSAllowsArbitraryLoads.
	-->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- The image preview's Share button offers "Save Image"; iOS requires this string for it. -->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Clubhouse Go saves images you choose to share from your agents' conversations to your photo library.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_clubhouse-annex._tcp</string>
		<string>_clubhouse-annex._tcp.</string>
	</array>
</dict>
</plist>
