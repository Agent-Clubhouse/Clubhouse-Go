+        func close() {
+            CompanionTranscriptActionProbe.record = nil
+            CompanionConversationBuildProbe.record = nil
+            CompanionReadingOpeningProbe.didComputeSeed = nil
+            window.isHidden = true
+            window.rootViewController = nil
+            store.shutdown()
