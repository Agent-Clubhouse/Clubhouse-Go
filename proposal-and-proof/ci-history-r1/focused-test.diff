+    private func visibleEntryDistance(_ entryID: String, bookmark: CompanionReadingBookmark) -> Double? {
+        let viewport = bookmark.viewport
+        guard let metrics = viewport.metrics, let frame = viewport.frames[entryID] else { return nil }
+        let offset = metrics.normalizedOffset
+        let height = max(0, metrics.containerHeight - metrics.topInset - metrics.bottomInset)
+        guard frame.upperBound > offset + CompanionReadingPosition.minimumVisibleExtent,
+              frame.lowerBound < offset + height else { return nil }
+        return offset - frame.lowerBound
+    }
+
+    private func isRestored(_ expected: CompanionReadingPosition, bookmark: CompanionReadingBookmark) -> Bool {
+        let viewport = bookmark.viewport
+        guard viewport.hasInitialized, !viewport.isRestoring, viewport.restoration?.outcome == .arrived,
+              !bookmark.position.followsLatest, let id = expected.entryID, bookmark.position.entryID == id,
+              let distance = visibleEntryDistance(id, bookmark: bookmark) else { return false }
+        // Bookmark-first remounts change the content origin, not the saved entry or its pixel alignment.
+        return abs(distance - expected.distanceFromEntry) <= 1
+            && abs(bookmark.position.distanceFromEntry - expected.distanceFromEntry) <= 1
+    }
+
